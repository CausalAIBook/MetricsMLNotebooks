       "width": 525
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "p1 <- ggplot(df, aes(x = groups, y = estimate)) +\n",
    "  geom_line() +\n",
    "  geom_ribbon(aes(ymin = lwr.ci, ymax = upr.ci), alpha = 0.1, col = \"blue\", fill = \"blue\") +\n",
    "  theme_bw() +\n",
    "  xlab(\"Income Groups by Quartiles\") +\n",
    "  ylab(\"ATE\") +\n",
    "  ggtitle(\"Under conditional ignorability\")\n",
    "\n",
    "ggsave(\"figures/401K-groups-noconfounding.pdf\", p1, width = 4.5, height = 4.5)\n",
    "p1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "90b555b3",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-11T14:55:06.692037Z",
     "iopub.status.busy": "2026-09-11T14:55:06.691679Z",
