   "source": [
    "rho2.half <- (1/2)^2\n",
    "\n",
    "pdf(\"figures/401K-contour-plm-lower-rho2.pdf\", width = 6, height = 6)\n",
    "contour_panel(dml.401k.plm, out, rho2 = rho2.half, title = expression(paste(\"Partially Linear Model,  |\", rho, \"| = 1/2\")))\n",
    "invisible(dev.off())\n",
