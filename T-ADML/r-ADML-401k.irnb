    }
   ],
   "source": [
    "out <- summary(bench.plm)$benchmarks\n",
    "round(out[, c(\"gain.Y\", \"gain.D\", \"rho\")], 4)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "70083858",
   "metadata": {},
   "source": [
    "## Contour Plots"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "c850176c",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "ovb_contour_without_origin_label <-\n",
    "  getS3method(\"ovb_contour_plot\", \"dml\")\n",
    "\n",
    "plot_body <- as.list(body(ovb_contour_without_origin_label))\n",
    "\n",
    "is_origin_label <- vapply(\n",
    "  plot_body,\n",
    "  function(expr) {\n",
    "    is.call(expr) &&\n",
    "      identical(expr[[1L]], as.name(\"text\")) &&\n",
    "      \"label.unadjusted\" %in% all.names(expr)\n",
    "  },\n",
    "  logical(1)\n",
    ")\n",
    "\n",
    "# Verify that we found exactly the intended annotation.\n",
    "stopifnot(sum(is_origin_label) == 1L)\n",
    "\n",
    "plot_body[is_origin_label] <- list(quote(invisible(NULL)))\n",
    "\n",
    "body(ovb_contour_without_origin_label) <- as.call(plot_body)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "e65ef369",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-11T14:56:25.285890Z",
     "iopub.status.busy": "2026-09-11T14:56:25.285593Z",
     "iopub.status.idle": "2026-09-11T14:56:25.289940Z",
     "shell.execute_reply": "2026-09-11T14:56:25.289562Z"
    },
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "bumps.plm <- list(pira    = c(0.010,  0.009),\n",
    "                  twoearn = c(0.020, -0.002),\n",
    "                  inc     = c(0.010,  0.009),\n",
    "                  inc4    = c(0.015, -0.005))\n",
    "\n",
    "bumps.npm <- list(pira    = c(0.005,  0.009),\n",
    "                  twoearn = c(0.020,  0.005),\n",
    "                  inc     = c(-0.010, 0.009),\n",
    "                  inc4    = c(0.015,  0.000))\n",
    "\n",
    "contour_panel <- function(fit, bench, rho2, title, bumps = bumps.plm) {\n",
    "  ovb_contour_without_origin_label(\n",
    "    fit,\n",
    "    which.bound = \"lwr\",\n",
    "    level = 0.95,\n",
    "    cf.y = NULL,\n",
    "    rho2 = rho2,\n",
    "    col.contour = \"blue\",\n",
    "    label.bump.x = 0.015,\n",
    "    label.bump.y = 0.003,\n",
    "    lim.x = 0.16\n",
    "  )\n",
    "\n",
    "  title(main = title)\n",
    "\n",
    "  add_bound <- function(cfd, cfy, label, bump.x, bump.y, ...) {\n",
    "    sensemakr::add_bound_to_contour(\n",
    "      r2dz.x = cfd, r2yz.dx = cfy,\n",
    "      bound_label = label,\n",
    "      bound_value = confidence_bounds(\n",
    "        fit, cf.y = cfy, cf.d = cfd, rho2 = rho2,\n",
    "        level = 0.95, combine.method = \"median\"\n",
    "      )[\"ate\", \"lwr\"],\n",
    "      label.bump.x = bump.x, label.bump.y = bump.y, ...)\n",
    "  }\n",
    "\n",
    "  add_bound(0.03, 0.04, \"Max Match\", 0.015, 0.003, point.pch = 25, point.bg = \"red\")\n",
    "\n",
    "  # one-times each observed benchmark\n",
    "  add_bound(bench[\"pira\",    \"gain.D\"], bench[\"pira\",    \"gain.Y\"], \"1 x Part. in IRA\",\n",
    "            bumps$pira[1], bumps$pira[2])\n",
    "  add_bound(bench[\"twoearn\", \"gain.D\"], bench[\"twoearn\", \"gain.Y\"], \"1 x Two Earners\",\n",
    "            bumps$twoearn[1], bumps$twoearn[2])\n",
    "  add_bound(bench[\"inc\",     \"gain.D\"], bench[\"inc\",     \"gain.Y\"], \"1 x Income\",\n",
    "            bumps$inc[1], bumps$inc[2])\n",
    "\n",
    "  # a quarter as strong as income\n",
    "  add_bound(bench[\"inc\", \"gain.D\"] * 0.25, bench[\"inc\", \"gain.Y\"] * 0.25, \"1/4 x Income\",\n",
    "            bumps$inc4[1], bumps$inc4[2])\n",
    "\n",
    "  # unadjusted\n",
    "  add_bound(0, 0, \"Unadjusted\", bump.x = 0.015, bump.y = 0.003, point.pch = NA)            \n",
    "\n",
    "  invisible(NULL)\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2522b94d",
   "metadata": {},
   "source": [
    "### Partially Linear Model\n"
