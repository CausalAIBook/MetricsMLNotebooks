  {
   "cell_type": "markdown",
   "id": "c026",
   "metadata": {},
   "source": [
    "## Sensitivity Results for the Full Sample\n",
    "\n",
    "For the full sample we report the short elasticity, the sensitivity bounds and their confidence bounds under the scenario $C_Y^2 = 0.03$, $C_D^2 \\approx 0.03$ and $|\\rho| = 1$, together with robustness values."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "c027",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "table_rr <- list()\n",
    "q5_ests  <- ests_rr[[\"q=5\"]]\n",
    "\n",
    "table_rr[[\"point\"]] <- sprintf(\"%.3f (%.3f)\",\n",
    "  res_rr[[\"q=5\"]]$point, res_rr[[\"q=5\"]]$stderr)\n",
    "table_rr[[\"Bounds\"]] <- sprintf(\"[%.3f, %.3f]\",\n",
    "  sensitivity_bounds_r(q5_ests, .03, .03, alpha=NULL)[1],\n",
    "  sensitivity_bounds_r(q5_ests, .03, .03, alpha=NULL)[2])\n",
    "table_rr[[\"CIBounds\"]] <- sprintf(\"[%.3f, %.3f]\",\n",
    "  sensitivity_bounds_r(q5_ests, .03, .03, alpha=.05)[1],\n",
    "  sensitivity_bounds_r(q5_ests, .03, .03, alpha=.05)[2])\n",
    "table_rr[[\"RV(v=-1.5)\"]]    <- sprintf(\"%.3f\", tvalue_r(q5_ests, value=-1.5, leq=TRUE))\n",
    "table_rr[[\"RV(v=-1.5,a=.05)\"]] <- sprintf(\"%.3f\", tvalue_r(q5_ests, value=-1.5, leq=TRUE, alpha=.05))\n",
    "table_rr[[\"RV(v=0)\"]]       <- sprintf(\"%.3f\", tvalue_r(q5_ests, value=0, leq=FALSE))\n",
    "table_rr[[\"RV(v=0,a=.05)\"]] <- sprintf(\"%.3f\", tvalue_r(q5_ests, value=0, leq=FALSE, alpha=.05))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "c028",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "table_dml <- list()\n",
    "q5_dml   <- ests_dml[[\"q=5\"]]\n",
    "\n",
    "table_dml[[\"point\"]] <- sprintf(\"%.3f (%.3f)\",\n",
    "  res_dml[[\"q=5\"]]$point, res_dml[[\"q=5\"]]$stderr)\n",
    "table_dml[[\"Bounds\"]] <- sprintf(\"[%.3f, %.3f]\",\n",
    "  dml_sensitivity_bounds_r(q5_dml, .03, .03, alpha=NULL)[1],\n",
    "  dml_sensitivity_bounds_r(q5_dml, .03, .03, alpha=NULL)[2])\n",
    "table_dml[[\"CIBounds\"]] <- sprintf(\"[%.3f, %.3f]\",\n",
    "  dml_sensitivity_bounds_r(q5_dml, .03, .03, alpha=.05)[1],\n",
    "  dml_sensitivity_bounds_r(q5_dml, .03, .03, alpha=.05)[2])\n",
    "table_dml[[\"RV(v=-1.5)\"]]    <- sprintf(\"%.3f\", dml_tvalue_r(q5_dml, value=-1.5, leq=TRUE))\n",
    "table_dml[[\"RV(v=-1.5,a=.05)\"]] <- sprintf(\"%.3f\", dml_tvalue_r(q5_dml, value=-1.5, leq=TRUE, alpha=.05))\n",
    "table_dml[[\"RV(v=0)\"]]       <- sprintf(\"%.3f\", dml_tvalue_r(q5_dml, value=0, leq=FALSE))\n",
    "table_dml[[\"RV(v=0,a=.05)\"]] <- sprintf(\"%.3f\", dml_tvalue_r(q5_dml, value=0, leq=FALSE, alpha=.05))"
   ]
  },
