  {
   "cell_type": "markdown",
   "id": "c022",
   "metadata": {},
   "source": [
    "### Partially Linear Model\n",
    "\n",
    "The second specification is the partially linear model $Y = \\theta_s D + f_s(X^o) + \\varepsilon$, estimated by partialling out with random forests."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "c023",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "dml_estimator_r <- function(X, y, splits) {\n",
    "  n    <- nrow(X)\n",
    "  D    <- X[, 1L]\n",
    "  Xcov <- X[, -1L, drop = FALSE]\n",
    "  yres <- Dres <- numeric(n)\n",
    "\n",
    "  for (s in splits) {\n",
    "    tr <- s$train; te <- s$test\n",
    "    df_y <- as.data.frame(cbind(y_tr = y[tr], Xcov[tr, ]))\n",
    "    df_d <- as.data.frame(cbind(D_tr = D[tr], Xcov[tr, ]))\n",
    "    rf_y <- ranger(y_tr ~ ., data = df_y, num.trees = 200L, verbose = FALSE)\n",
    "    rf_d <- ranger(D_tr ~ ., data = df_d, num.trees = 200L, verbose = FALSE)\n",
    "    yres[te] <- y[te] - predict(rf_y, data=as.data.frame(Xcov[te,]))$predictions\n",
    "    Dres[te] <- D[te] - predict(rf_d, data=as.data.frame(Xcov[te,]))$predictions\n",
    "  }\n",
    "\n",
    "  nusq  <- mean(Dres^2)\n",
    "  theta <- mean(yres * Dres) / nusq\n",
    "  psi   <- (yres - Dres * theta) * Dres / nusq\n",
    "  se    <- sqrt(mean(psi^2) / n)\n",
    "  list(\n",
    "    estimates = c(point=theta, se=se, lower=theta-1.645*se, upper=theta+1.645*se),\n",
    "    model     = list(yres=yres, Dres=Dres)\n",
    "  )\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "c024",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
