   ],
   "source": [
    "rr_results <- generic_pipeline_r(nonlinrr_r, q_grid, \"dr\", n_seeds = 5L)\n",
    "res_rr <- rr_results$res\n",
    "ests_rr <- rr_results$ests"
   ]
  },
