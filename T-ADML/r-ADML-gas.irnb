     "output_type": "display_data"
    }
   ],
   "source": [
    "qgr  <- 1:4\n",
    "point <- sapply(qgr, function(q) res_rr[[sprintf(\"q=%d\",q)]]$point)\n",
    "se    <- sapply(qgr, function(q) res_rr[[sprintf(\"q=%d\",q)]]$stderr)\n",
    "lower <- point - 1.645 * se\n",
    "upper <- point + 1.645 * se\n",
    "sens_lo <- sapply(qgr, function(q)\n",
    "  sensitivity_bounds_r(ests_rr[[sprintf(\"q=%d\",q)]], .03, .03, alpha=NULL)[1])\n",
    "sens_hi <- sapply(qgr, function(q)\n",
    "  sensitivity_bounds_r(ests_rr[[sprintf(\"q=%d\",q)]], .03, .03, alpha=NULL)[2])\n",
    "sens_lo95 <- sapply(qgr, function(q)\n",
    "  sensitivity_bounds_r(ests_rr[[sprintf(\"q=%d\",q)]], .03, .03, alpha=.05)[1])\n",
    "sens_hi95 <- sapply(qgr, function(q)\n",
    "  sensitivity_bounds_r(ests_rr[[sprintf(\"q=%d\",q)]], .03, .03, alpha=.05)[2])\n",
    "\n",
    "df_rr <- data.frame(q=qgr, point, lower, upper, sens_lo, sens_hi, sens_lo95, sens_hi95)\n",
    "\n",
    "ggplot(df_rr, aes(x=q)) +\n",
    "  geom_line(aes(y=point)) +\n",
    "  geom_ribbon(aes(ymin=lower, ymax=upper), alpha=.4, fill=\"steelblue\") +\n",
    "  geom_ribbon(aes(ymin=sens_lo, ymax=sens_hi), alpha=.6, fill=\"orange\") +\n",
    "  geom_ribbon(aes(ymin=sens_lo95, ymax=sens_hi95), alpha=.2, fill=\"orange\") +\n",
    "  scale_x_continuous(breaks=qgr) +\n",
    "  xlab(\"Income group\") + ylab(\"Average price elasticity\") +\n",
    "  ggtitle(\"Non-parametric\") +\n",
    "  theme_bw()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "c031",
