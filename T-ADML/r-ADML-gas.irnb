   "source": [
    "point_d <- sapply(qgr, function(q) res_dml[[sprintf(\"q=%d\",q)]]$point)\n",
    "se_d    <- sapply(qgr, function(q) res_dml[[sprintf(\"q=%d\",q)]]$stderr)\n",
    "lower_d <- point_d - 1.645 * se_d\n",
    "upper_d <- point_d + 1.645 * se_d\n",
    "sens_lo_d <- sapply(qgr, function(q)\n",
    "  dml_sensitivity_bounds_r(ests_dml[[sprintf(\"q=%d\",q)]], .03, .03, alpha=NULL)[1])\n",
    "sens_hi_d <- sapply(qgr, function(q)\n",
    "  dml_sensitivity_bounds_r(ests_dml[[sprintf(\"q=%d\",q)]], .03, .03, alpha=NULL)[2])\n",
    "sens_lo95_d <- sapply(qgr, function(q)\n",
    "  dml_sensitivity_bounds_r(ests_dml[[sprintf(\"q=%d\",q)]], .03, .03, alpha=.05)[1])\n",
    "sens_hi95_d <- sapply(qgr, function(q)\n",
    "  dml_sensitivity_bounds_r(ests_dml[[sprintf(\"q=%d\",q)]], .03, .03, alpha=.05)[2])\n",
    "\n",
    "df_dml <- data.frame(q=qgr, point=point_d, lower=lower_d, upper=upper_d,\n",
    "                     sens_lo=sens_lo_d, sens_hi=sens_hi_d,\n",
    "                     sens_lo95=sens_lo95_d, sens_hi95=sens_hi95_d)\n",
    "\n",
    "ggplot(df_dml, aes(x=q)) +\n",
    "  geom_line(aes(y=point)) +\n",
    "  geom_ribbon(aes(ymin=lower, ymax=upper), alpha=.4, fill=\"steelblue\") +\n",
    "  geom_ribbon(aes(ymin=sens_lo, ymax=sens_hi), alpha=.6, fill=\"orange\") +\n",
    "  geom_ribbon(aes(ymin=sens_lo95, ymax=sens_hi95), alpha=.2, fill=\"orange\") +\n",
    "  scale_x_continuous(breaks=qgr) +\n",
    "  xlab(\"Income group\") + ylab(\"Average price elasticity\") +\n",
    "  ggtitle(\"Partially linear\") +\n",
    "  theme_bw()"
   ]
  }
